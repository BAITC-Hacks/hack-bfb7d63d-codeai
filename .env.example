# Copy this file to .env. Keep keys on this computer; never paste them into chat.
# Set true only when you want the explicit AI button to call the chosen provider.
MONEYMAP_AI_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini-2025-04-14
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.3-70b-instruct
# Local app limits, NOT the balance or billing cap of your provider account.
MONEYMAP_AI_BUDGET_USD=1.00
MONEYMAP_AI_MAX_REQUESTS=20
MONEYMAP_AI_MAX_TOTAL_TOKENS=200000
